# Replace with your VPS Public IPv4 address (e.g. 198.51.100.24) or domain name
VPS_PUBLIC_IP=YOUR_VPS_PUBLIC_IP

# Password used to log in to the WireGuard Web Admin UI (http://YOUR_VPS_IP:51821)
WG_ADMIN_PASSWORD=SetAStrongPasswordHere123!

# Port for the God-Level Cyber-Command Dashboard (Default: 8888)
DASHBOARD_PORT=8888

# MongoDB Connection String (Atlas URI or local Docker MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyberproxy?retryWrites=true&w=majority

# Operator Dashboard Authentication
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=ProxyMaster2025!
JWT_SECRET=cyber-proxy-super-secret-key-2025-change-me
